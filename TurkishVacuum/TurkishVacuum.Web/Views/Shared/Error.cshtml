@model ErrorViewModel
@{
    ViewData["Title"] = Model.IsNotFound ? T("Sayfa Bulunamadı", "Page Not Found") : T("Bir Hata Oluştu", "Something Went Wrong");
    ViewData["NoIndex"] = true;
}

<section class="section error-section">
    <div class="container error-box">
        <span class="error-code">@(Model.StatusCode?.ToString() ?? T("Hata", "Error"))</span>
        @if (Model.IsNotFound)
        {
            <h1>@T("Aradığınız sayfa bulunamadı", "We couldn't find that page")</h1>
            <p>@T("Sayfa taşınmış veya kaldırılmış olabilir. Yardıma ihtiyacınız varsa bize telefonla ulaşabilirsiniz.", "It may have been moved or removed. If you need help, you can reach us by phone.")</p>
        }
        else
        {
            <h1>@T("Bir hata oluştu", "Something went wrong")</h1>
            <p>@T("İsteğiniz işlenirken beklenmeyen bir sorun oluştu. Lütfen biraz sonra tekrar deneyin ya da bize doğrudan ulaşın.", "An unexpected problem occurred while processing your request. Please try again shortly or contact us directly.")</p>
        }
        <div class="btn-row btn-row--center">
            <a class="btn btn-primary btn-lg" href="@SiteInfo.PhoneLink">
                <i class="bi bi-telephone-fill" aria-hidden="true"></i> <span class="nowrap">@PhoneText</span>
            </a>
            <a class="btn btn-outline btn-lg" href="@PageUrl("Index")">
                <i class="bi bi-house-door" aria-hidden="true"></i> @T("Ana Sayfaya Dön", "Back to Home")
            </a>
        </div>
        @if (Model.ShowRequestId && !Model.IsNotFound)
        {
            <p class="error-request">@T("Talep kimliği:", "Request ID:") <code>@Model.RequestId</code></p>
        }
    </div>
</section>

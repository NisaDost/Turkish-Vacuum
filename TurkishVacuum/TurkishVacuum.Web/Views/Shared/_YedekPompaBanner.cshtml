@* Konsinye yedek pompa desteğinin kısa, şerit hâli (Destek ve Yedek Parça sayfaları) *@
<div class="loaner-strip" data-reveal>
    <span class="loaner-strip-icon" aria-hidden="true"><i class="bi bi-arrow-left-right"></i></span>
    <div class="loaner-strip-text">
        <strong>@T("Pompanız tamirdeyken üretiminiz durmasın.", "Keep production running while your pump is repaired.")</strong>
        <span>@T("Tamir süresince yedek pompa (konsinye) temin edilebilir.", "A loaner pump (on consignment) can be supplied during repairs.")</span>
    </div>
    <a class="btn btn-whatsapp" href="@LoanerPumpWhatsAppLink" target="_blank" rel="noopener">
        <i class="bi bi-whatsapp" aria-hidden="true"></i> @T("Yedek Pompa Talep Et", "Request a Loaner Pump")
    </a>
</div>

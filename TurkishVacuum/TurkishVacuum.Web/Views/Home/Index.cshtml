@inject InstagramFeed InstagramFeed
@{
    ViewData["Title"] = T("Ana Sayfa", "Home");
    ViewData["PageTitle"] = T("İzmir Vakum Pompası Tamiri ve 7/24 Servis | Turkish Vakum", "Vacuum Pump Repair & 24/7 Service in İzmir | Turkish Vakum");
    ViewData["Description"] = T("Vakum pompanız mı arızalandı? İzmir merkezli 7/24 teknik servis: tamir, bakım, revizyon ve yedek parça. Tamir süresince yedek pompa (konsinye) desteğiyle üretiminiz durmasın.",
                                "Vacuum pump down? 24/7 technical service from İzmir, Türkiye: repair, maintenance, overhaul and spare parts. Loaner pumps during repairs keep your production running.");
    ViewData["HideCtaBand"] = true; // sayfa zaten iletişim bölümüyle bitiyor
}

<section class="hero" aria-labelledby="hero-title">
    <div class="hero-slides" aria-hidden="true">
        <img class="hero-slide active" src="~/images/slide1.jpg" alt="" width="1200" height="673" fetchpriority="high" />
        <img class="hero-slide" src="~/images/slide2.jpg" alt="" width="1642" height="1095" decoding="async" fetchpriority="low" />
        <img class="hero-slide" src="~/images/slide3.jpg" alt="" width="1200" height="800" decoding="async" fetchpriority="low" />
    </div>
    <div class="hero-overlay"></div>

    <div class="container hero-content">
        @if (IsEnglish)
        {
            <h1 id="hero-title">Vacuum Pump Repair, Maintenance &amp; <span class="text-accent">Spare Parts</span></h1>
            <p class="hero-lead">
                Technical service for oil-sealed, liquid ring and dry vacuum pumps of all brands, available 24/7.
                <strong>With a loaner pump during repairs</strong>, your production keeps running.
            </p>
        }
        else
        {
            <h1 id="hero-title">Vakum Pompası Tamir, Bakım ve <span class="text-accent">Yedek Parça</span></h1>
            <p class="hero-lead">
                Tüm marka yağlı, sulu ve kuru vakum pompaları için 7/24 teknik servis.
                <strong>Tamir süresince yedek pompa desteğiyle</strong> üretiminiz aksamaz.
            </p>
        }
        <div class="hero-actions">
            <a class="btn btn-primary btn-lg" href="@SiteInfo.PhoneLink">
                <i class="bi bi-telephone-fill" aria-hidden="true"></i> <span class="nowrap">@PhoneText</span>
            </a>
            <a class="btn btn-ghost-light btn-lg" href="@WhatsAppLink" target="_blank" rel="noopener">
                <i class="bi bi-whatsapp" aria-hidden="true"></i> @T("WhatsApp'tan Yazın", "Message on WhatsApp")
            </a>
        </div>
        <ul class="hero-points">
            <li><i class="bi bi-check-circle-fill" aria-hidden="true"></i> @T("Tüm marka ve modeller", "All brands & models")</li>
            <li><i class="bi bi-check-circle-fill" aria-hidden="true"></i> @T("Yağlı · Sulu · Kuru pompalar", "Oil-sealed · Liquid ring · Dry pumps")</li>
            <li><i class="bi bi-check-circle-fill" aria-hidden="true"></i> @T("Tamir süresince yedek pompa", "Loaner pumps during repairs")</li>
        </ul>
    </div>
</section>

<section class="features" aria-label="@T("Neden Turkish Vakum?", "Why Turkish Vakum?")">
    <div class="features-grid">
        <div class="feature-card" data-reveal>
            <span class="feature-icon feature-icon--red" aria-hidden="true"><i class="bi bi-clock-history"></i></span>
            <div>
                <h2>@T("7/24 Ulaşılabilir", "Available 24/7")</h2>
                <p>@T("Gece ya da hafta sonu, telefon ve WhatsApp'tan bize ulaşabilirsiniz.", "Reach us by phone or WhatsApp, including nights and weekends.")</p>
            </div>
        </div>
        <div class="feature-card" data-reveal>
            <span class="feature-icon feature-icon--blue" aria-hidden="true"><i class="bi bi-arrow-left-right"></i></span>
            <div>
                <h2>@T("Yedek Pompa (Konsinye)", "Loaner Pump (Consignment)")</h2>
                <p>@T("Tamir süresince yedek pompa temin edilebilir; üretiminiz durmaz.", "A loaner pump can be supplied during repairs, so production never stops.")</p>
            </div>
        </div>
        <div class="feature-card" data-reveal>
            <span class="feature-icon" aria-hidden="true"><i class="bi bi-tools"></i></span>
            <div>
                <h2>@T("Tüm Marka & Model", "All Brands & Models")</h2>
                <p>@T("Yerli ve yabancı yağlı, sulu ve kuru vakum pompaları.", "Domestic and imported oil-sealed, liquid ring and dry vacuum pumps.")</p>
            </div>
        </div>
        <div class="feature-card" data-reveal>
            <span class="feature-icon" aria-hidden="true"><i class="bi bi-patch-check"></i></span>
            <div>
                <h2>@T("10+ Yıl Tecrübe", "10+ Years of Experience")</h2>
                <p>@T("2015'ten bu yana vakum teknolojilerinde uzmanlık.", "Vacuum technology specialists since 2015.")</p>
            </div>
        </div>
    </div>
</section>

<partial name="_ArizaBildir" />

<partial name="_YedekPompa" />

<section class="section process-section bg-soft" aria-labelledby="surec-title">
    <div class="container">
        <div class="section-head" data-reveal>
            <span class="eyebrow">@T("Nasıl Çalışıyoruz?", "How We Work")</span>
            <h2 class="section-title" id="surec-title">@T("Arızadan teslimata 4 adım", "From breakdown to delivery in 4 steps")</h2>
            <p class="section-lead">@T("Süreci sizin için basit tutuyoruz; siz sadece bize ulaşın.", "We keep it simple — all you have to do is get in touch.")</p>
        </div>
        <ol class="process-steps">
            <li class="step" data-reveal>
                <span class="step-no" aria-hidden="true">01</span>
                <span class="step-icon" aria-hidden="true"><i class="bi bi-telephone-inbound-fill"></i></span>
                <h3>@T("Bize ulaşın", "Contact us")</h3>
                <p>@T("7/24 telefon veya WhatsApp ile arızayı bildirin.", "Report the fault 24/7 by phone or WhatsApp.")</p>
            </li>
            <li class="step" data-reveal>
                <span class="step-no" aria-hidden="true">02</span>
                <span class="step-icon" aria-hidden="true"><i class="bi bi-search"></i></span>
                <h3>@T("Arıza tespiti", "Diagnosis")</h3>
                <p>@T("Pompanız uzman ekibimizce incelenir ve net teşhis konur.", "Our experts inspect your pump and pinpoint the problem.")</p>
            </li>
            <li class="step step--highlight" data-reveal>
                <span class="step-no" aria-hidden="true">03</span>
                <span class="step-icon" aria-hidden="true"><i class="bi bi-arrow-left-right"></i></span>
                <h3>@T("Yedek pompa", "Loaner pump")</h3>
                <p>@T("Gerekirse tamir süresince yedek pompa temin edilir; üretim devam eder.", "If needed, a loaner pump is supplied during the repair so production continues.")</p>
            </li>
            <li class="step" data-reveal>
                <span class="step-no" aria-hidden="true">04</span>
                <span class="step-icon" aria-hidden="true"><i class="bi bi-check2-circle"></i></span>
                <h3>@T("Tamir & teslim", "Repair & delivery")</h3>
                <p>@T("Onarılan pompanız test edilir ve çalışır hâlde teslim edilir.", "Your repaired pump is tested and delivered in working order.")</p>
            </li>
        </ol>
    </div>
</section>

<partial name="_Hizmetler" />

<section class="section embeds-section bg-soft" aria-labelledby="sosyal-title">
    <div class="container">
        <div class="section-head" data-reveal>
            <span class="eyebrow">@T("Atölyeden", "From the Workshop")</span>
            <h2 class="section-title" id="sosyal-title">@T("Sosyal Medyada Biz", "Follow Us on Social Media")</h2>
            <p class="section-lead">@T("Instagram'daki en çok ilgi gören tamir ve bakım paylaşımlarımız.", "Our most popular repair and maintenance posts on Instagram.")</p>
        </div>
        @* Gönderiler Instagram'dan otomatik seçilir (Services/InstagramSyncService.cs) *@
        <div class="embeds-grid">
            @foreach (var permalink in InstagramFeed.Permalinks)
            {
                var embedUrl = permalink + (permalink.Contains('?') ? "&" : "?") + "utm_source=ig_embed&utm_campaign=loading";
                <div>
                    <blockquote class="instagram-media" data-instgrm-permalink="@embedUrl" data-instgrm-version="14"></blockquote>
                </div>
            }
        </div>
        <div class="embeds-more">
            <a class="btn btn-outline" href="@SiteInfo.InstagramUrl" target="_blank" rel="noopener">
                <i class="bi bi-instagram" aria-hidden="true"></i> @T("Instagram'da takip edin", "Follow us on Instagram")
            </a>
        </div>
    </div>
</section>

<partial name="_IletisimBilgileri" />

@{
    ViewData["Title"] = T("İletişim", "Contact");
    ViewData["PageTitle"] = T("İletişim | 7/24 Vakum Pompası Servisi İzmir – Turkish Vakum", "Contact | 24/7 Vacuum Pump Service in İzmir – Turkish Vakum");
    ViewData["Description"] = T("Telefon (7/24): " + SiteInfo.PhoneDisplay + ". " + SiteInfo.Address + ". WhatsApp, telefon ve e-posta ile bize ulaşın.",
                                "Phone (24/7): " + SiteInfo.PhoneDisplayInternational + ". " + SiteInfo.Address + ", Türkiye. Reach us by WhatsApp, phone or email.");
    ViewData["HideCtaBand"] = true;
}

<section class="page-hero" style="--page-hero-img: url('/images/4.jpg')">
    <div class="container">
        <nav class="breadcrumb" aria-label="@T("Sayfa yolu", "Breadcrumb")">
            <a href="@PageUrl("Index")">@T("Ana Sayfa", "Home")</a>
            <i class="bi bi-chevron-right" aria-hidden="true"></i>
            <span aria-current="page">@T("İletişim", "Contact")</span>
        </nav>
        @if (IsEnglish)
        {
            <h1>Get in <span class="text-accent">touch</span></h1>
            <p>Reach us 24/7 by phone or WhatsApp for breakdowns, maintenance, spare parts and loaner pump requests.</p>
        }
        else
        {
            <h1>Bize <span class="text-accent">ulaşın</span></h1>
            <p>Arıza, bakım, yedek parça ya da yedek pompa talepleriniz için telefon ve WhatsApp üzerinden 7/24 ulaşabilirsiniz.</p>
        }
        <div class="btn-row">
            <a class="btn btn-primary btn-lg" href="@SiteInfo.PhoneLink">
                <i class="bi bi-telephone-fill" aria-hidden="true"></i> <span class="nowrap">@PhoneText</span>
            </a>
            <a class="btn btn-whatsapp btn-lg" href="@WhatsAppLink" target="_blank" rel="noopener">
                <i class="bi bi-whatsapp" aria-hidden="true"></i> @T("WhatsApp'tan Yazın", "Message on WhatsApp")
            </a>
        </div>
    </div>
</section>

<partial name="_IletisimBilgileri" />
